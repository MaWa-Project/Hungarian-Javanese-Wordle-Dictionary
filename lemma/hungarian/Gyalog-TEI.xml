      <cit type="example">
        <quote xml:lang="Hu" script="Latin">Gyalog megyek az iskolába</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲎𐳀𐳖𐳛𐳍 𐳘𐳉𐳎𐳉𐳓 𐳀𐳯 𐳐𐳤𐳓𐳛𐳖𐳁𐳂𐳀
        </quote>
        <quote xml:lang="Jv" script="Latin">aku mlaku menyang sekolah</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦏꦸꦩ꧀ꦭꦏꦸꦩꦼꦤꦪꦁꦱꦼꦏꦺꦴꦭꦃ
        </quote>
      </cit>
