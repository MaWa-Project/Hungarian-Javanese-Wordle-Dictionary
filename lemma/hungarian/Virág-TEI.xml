        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Jv" script="Latin">
          	bagéan tetuwuhan sing éndah lan ana wernané
          </seg>
          <seg xml:lang="Jv" script="Jv">
            ꦧꦒꦺꦪꦤ꧀ꦠꦼꦠꦸꦮꦸꦃꦲꦤ꧀ꦱꦶꦁꦲꦺꦤ꧀ꦣꦃꦭꦤ꧀ꦲꦤꦮꦼꦂꦤꦤꦺ
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Hu" script="Latin">A virág szép a kertben</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳮𐳐𐳢𐳁𐳍 𐳥𐳋𐳠 𐳀 𐳓𐳉𐳢𐳦𐳂𐳉𐳙
        </quote>
        <quote xml:lang="Jv" script="Latin">kembang kuwi endah ing patamanan</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦏꦼꦩ꧀ꦧꦁꦏꦸꦮꦶꦲꦺꦤ꧀ꦣꦃꦲꦶꦁꦥꦠꦩꦤ꧀ꦤꦤ꧀
        </quote>
      </cit>
