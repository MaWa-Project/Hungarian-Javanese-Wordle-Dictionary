          <orth script="Latin">wantun</orth>
          <orth script="Jv">ꦮꦤ꧀ꦠꦸꦤ꧀</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Jv" script="Latin">
          	wong sing ora wedi ngadhepi bebaya
          </seg>
          <seg xml:lang="Jv" script="Jv">
            ꦮꦺꦴꦁꦱꦶꦁꦲꦺꦴꦫꦮꦼꦢꦶꦔꦝꦼꦥꦶꦧꦼꦧꦪ
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Hu" script="Latin">A bátor ember nem fél</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳂𐳁𐳦𐳛𐳢 𐳉𐳘𐳂𐳉𐳢 𐳙𐳉𐳘 𐳌𐳋𐳖
        </quote>
        <quote xml:lang="Jv" script="Latin">wong kendel kuwi ora wedi</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦮꦺꦴꦁꦏꦼꦤ꧀ꦢꦼꦭ꧀ꦏꦸꦮꦶꦲꦺꦴꦫꦮꦼꦢꦶ
        </quote>
      </cit>
