        <gramGrp>
          <pos>adjective</pos>
          <inflection type="comparison">
            <orth xml:lang="Hu" script="Latin">-bb</orth>
            <orth xml:lang="Hu" script="Runic">𐳂𐳂-</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="ngoko">
        <usg type="register" xml:lang="Jv">Ngoko</usg>
        <cit type="translation" xml:lang="Jv">
          <orth script="Latin">kendel</orth>
          <orth script="Jv">ꦏꦼꦤ꧀ꦢꦼꦭ꧀</orth>
        </cit>
      </sense>
      <sense xml:id="krama">
        <usg type="register" xml:lang="Jv">Krama</usg>
