          <orth script="Jv">ꦏꦺꦴꦫꦤ꧀</orth>
        </cit>
      </sense>
      <sense xml:id="krama">
        <usg type="register" xml:lang="Jv">Krama</usg>
        <cit type="translation" xml:lang="Jv">
          <orth script="Latin">layang kabar</orth>
          <orth script="Jv">ꦭꦪꦁꦏꦧꦂ</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Jv" script="Latin">
          	layang utawa kertas kang isi pawarta saben dina
          </seg>
          <seg xml:lang="Jv" script="Jv">
            ꦭꦪꦁꦲꦸꦠꦮꦏꦼꦂꦠꦱ꧀ꦏꦁꦲꦶꦱꦶꦥꦮꦂꦠꦱꦧꦼꦤ꧀ꦢꦶꦤ
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Hu" script="Latin">Az újság minden reggel megjelenik</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀𐳯 𐳫𐳒𐳤𐳁𐳍 𐳘𐳐𐳙𐳇𐳉𐳙 𐳢𐳉𐳍𐳍𐳉𐳖 𐳘𐳉𐳍𐳒𐳉𐳖𐳉𐳙𐳐𐳓
        </quote>
        <quote xml:lang="Jv" script="Latin">koran metu saben ésuk</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦏꦺꦴꦫꦤ꧀ꦩꦼꦠꦸꦱꦧꦼꦤ꧀ꦲꦺꦱꦸꦏ꧀
        </quote>
      </cit>
