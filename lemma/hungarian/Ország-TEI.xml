        </cit>
      </sense>
      <sense xml:id="krama">
        <usg type="register" xml:lang="Jv">Krama</usg>
        <cit type="translation" xml:lang="Jv">
          <orth script="Latin">nagari</orth>
          <orth script="Jv">ꦤꦒꦫꦶ</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Jv" script="Latin">
          	tlatah gedhé sing dadi panggonan sawijining bangsa
          </seg>
          <seg xml:lang="Jv" script="Jv">
            ꦠ꧀ꦭꦠꦃꦒꦼꦝꦺꦱꦶꦁꦢꦢꦶꦥꦁꦒꦺꦴꦤ꧀ꦤꦤ꧀ꦱꦮꦶꦗꦶꦤꦶꦁꦧꦁꦱ
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Hu" script="Latin">Az ország szép és nagy</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀𐳯 𐳛𐳢𐳤𐳯𐳁𐳍 𐳤𐳯𐳋𐳠 𐳋𐳤 𐳙𐳀𐳎
        </quote>
        <quote xml:lang="Jv" script="Latin">negara kuwi éndah lan gedhé</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦤꦼꦒꦫꦏꦸꦮꦶꦲꦺꦤ꧀ꦣꦃꦭꦤ꧀ꦒꦼꦝꦺ
        </quote>
      </cit>
