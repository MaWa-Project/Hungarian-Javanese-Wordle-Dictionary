<entry xml:id="puska">
	<form type="lemma">
    	<orth xml:lang="Hu" script="Latin">puska</orth>
        <orth xml:lang="Hu" script="Runic">𐳠𐳪𐳤𐳓𐳀</orth>
        <pron>
          <syllabic>pus·ka</syllabic>
          <ipa>[\\text{puʃkɒ}]</ipa>
        </pron>
        <gramGrp>
          <pos>substantive</pos>
          <inflection type="plural">
            <orth xml:lang="Hu" script="Latin">-k</orth>
            <orth xml:lang="Hu" script="Runic">𐳓-</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="ngoko">
        <usg type="register" xml:lang="Jv">Ngoko</usg>
        <cit type="translation" xml:lang="Jv">
          <orth script="Latin">cathetan</orth>
          <orth script="Jv">ꦕꦛꦼꦠ꧀ꦠꦤ꧀</orth>
        </cit>
      </sense>
      <sense xml:id="krama">
        <usg type="register" xml:lang="Jv">Krama</usg>
        <cit type="translation" xml:lang="Jv">
          <orth script="Latin">cathetan alit</orth>
          <orth script="Jv">ꦕꦛꦼꦠ꧀ꦠꦤ꧀ꦲꦭꦶꦠ꧀</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Jv" script="Latin">
          	kertas cilik kang isi cathetan kanggo mbantu nalika ulangan
          </seg>
          <seg xml:lang="Jv" script="Jv">
            ꦏꦼꦂꦠꦱ꧀ꦕꦶꦭꦶꦏ꧀ꦏꦁꦲꦶꦱꦶꦕꦛꦼꦠ꧀ꦠꦤ꧀ꦏꦁꦒꦺꦴꦩ꧀ꦧꦤ꧀ꦠꦸꦤꦭꦶꦏꦲꦸꦭꦔꦤ꧀
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Hu" script="Latin">A puska az asztalon van</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳠𐳪𐳤𐳓𐳀 𐳀 𐳯 𐳀𐳤𐳯𐳦𐳀𐳖𐳛𐳙 𐳮𐳀𐳙
        </quote>
        <quote xml:lang="Jv" script="Latin">cathetané ana ing meja</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦕꦛꦼꦠ꧀ꦠꦤꦺꦲꦤꦲꦶꦁꦩꦺꦗ
        </quote>
      </cit>
