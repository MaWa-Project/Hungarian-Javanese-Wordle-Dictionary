        <orth xml:lang="Jv" script="Jv">ꦲꦱꦽꦥ꧀</orth>
        <pron>
          <syllabic>as·rep</syllabic>
          <ipa>[\text{asrəp}]</ipa>
        </pron>
        <gramGrp>
          <pos>adjective</pos>
          <inflection type="reduplication">
            <orth xml:lang="Jv" script="Latin">asrep-asrep</orth>
            <orth xml:lang="Jv" script="Jv">ꦲꦱꦽꦥ꧀ꦲꦱꦽꦥ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">hideg</orth>
          <orth script="Runic">𐳏𐳐𐳇𐳉𐳍</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">hűvös</orth>
          <orth script="Runic">𐳏𐳭𐳮𐳝𐳤</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	alacsony hőmérsékletű, hideg
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳀𐳖𐳀𐳖𐳛𐳙𐳚 𐳏𐳟𐳘𐳋𐳢𐳤𐳋𐳓𐳖𐳑𐳭, 𐳏𐳐𐳇𐳉𐳍
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Asrep banyu es iku seger banget</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦱꦽꦥ꧀ꦧꦚꦸꦲꦺꦱ꧀ꦲꦶꦏꦸꦱꦼꦒꦼꦂꦧꦔꦼꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A hideg jégvíz nagyon frissítő</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳏𐳐𐳇𐳉𐳍 𐳒𐳋𐳍𐳮𐳑𐳯 𐳙𐳀𐳎𐳛𐳙 𐳌𐳢𐳐𐳤𐳤𐳐𐳦𐳟
        </quote>
      </cit>
