      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">szeretõ</orth>
          <orth script="Runic">𐳥𐳉𐳢𐳉𐳦𐳟</orth>
