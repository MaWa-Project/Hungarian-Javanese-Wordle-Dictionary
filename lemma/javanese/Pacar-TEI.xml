      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">kedves</orth>
          <orth script="Runic">𐳓𐳉𐳇𐳮𐳉𐳤</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	szerelmi kapcsolatban lévõ személy
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳥𐳉𐳢𐳉𐳖𐳘𐳐 𐳓𐳀𐳠𐳖𐳛𐳖𐳀𐳦𐳁𐳀𐳙 𐳖𐳋𐳮𐳟 𐳥𐳉𐳘𐳋𐳗
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Pacarku ayu banget</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦥꦕꦂꦏꦸꦲꦪꦸꦧꦔꦼꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A szerelmem nagyon szép</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳥𐳉𐳢𐳉𐳖𐳘𐳉𐳘 𐳙𐳀𐳎𐳛𐳙 𐳥𐳋𐳠
        </quote>
      </cit>
