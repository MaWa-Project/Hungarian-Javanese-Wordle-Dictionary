<?xml version="1.0" encoding="UTF-8"?>
<entry xml:id="putih">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">putih</orth>
        <orth xml:lang="Jv" script="Jv">ꦥꦸꦠꦶꦃ</orth>
        <pron>
          <syllabic>pu·tih</syllabic>
          <ipa>[\text{putɪh}]</ipa>
        </pron>
        <gramGrp>
          <pos>adjective</pos>
          <inflection type="reduplication">
            <orth xml:lang="Jv" script="Latin">putih-putih</orth>
            <orth xml:lang="Jv" script="Jv">ꦥꦸꦠꦶꦃꦥꦸꦠꦶꦃ</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">fehér</orth>
          <orth script="Runic">𐳌𐳉𐳏𐳋𐳢</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">hófehér</orth>
          <orth script="Runic">𐳏𐳜𐳌𐳉𐳏𐳋𐳢</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	világos szín, hó színű
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳮𐳐𐳖𐳁𐳍𐳛𐳤 𐳥𐳐𐳙, 𐳏𐳜 𐳥𐳐𐳚𐳭
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Putih resik luwih endah tinimbang kotor</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦥꦸꦠꦶꦃꦉꦱꦶꦏ꧀ꦭꦸꦮꦶꦃꦲꦼꦤ꧀ꦢꦃꦠꦶꦤꦶꦩ꧀ꦧꦁꦏꦺꦴꦠꦺꦴꦂ
        </quote>
        <quote xml:lang="Hu" script="Latin">A fehér szín tisztaságot jelent</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳌𐳉𐳏𐳋𐳢 𐳥𐳐𐳙 𐳦𐳐𐳤𐳦𐳀𐳤𐳁𐳍𐳛𐳦 𐳒𐳉𐳖𐳉𐳙𐳦
        </quote>
      </cit>
      <note type="synonyms">
        <list>
          <item>
            <orth script="Latin">pethak</orth>
		    <orth script="Jv">ꦥꦼꦛꦏ꧀</orth>
          </item>
        </list>
      </note>
      <note type="compounds">
        <list>
          <item>
            <orth script="Latin">-an</orth>
            <orth script="Jv">-ꦲꦤ꧀</orth>
          </item>
        </list>
      </note>
      <note type="crossReference">
        <ref target="#pethak">
          <orth script="Latin">pethak</orth>
          <orth script="Jv">ꦥꦼꦛꦏ꧀</orth>
        </ref>
      </note>
</entry>