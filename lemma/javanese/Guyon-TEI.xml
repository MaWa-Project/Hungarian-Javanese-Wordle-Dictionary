      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">viccel</orth>
          <orth script="Runic">𐳮𐳐𐳖𐳖𐳉𐳖</orth>
