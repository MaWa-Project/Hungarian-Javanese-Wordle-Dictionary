      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">vadonatúj</orth>
          <orth script="Runic">𐳮𐳀𐳇𐳛𐳙𐳀𐳦𐳫𐳒</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	nem régi, most készült vagy szerzett
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳙𐳉𐳘 𐳢𐳋𐳍𐳐, 𐳘𐳛𐳤𐳦 𐳓𐳋𐳥𐳬𐳖𐳦 𐳮𐳀𐳎 𐳥𐳉𐳢𐳯𐳉𐳦𐳦
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Aku tuku sepedah anyar wingi sore</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦏꦸꦠꦸꦏꦸꦱꦼꦥꦼꦢꦃꦲꦚꦂꦮꦶꦔꦶꦱꦺꦴꦫꦺ
        </quote>
        <quote xml:lang="Hu" script="Latin">Vettem egy új biciklit tegnap</quote>
        <quote xml:lang="Hu" script="Runic">
          𐳮𐳉𐳦𐳦𐳉𐳘 𐳉𐳎 𐳫𐳒 𐳁𐳐𐳖𐳐𐳓𐳖𐳐𐳦 𐳦𐳉𐳍𐳋𐳀𐳠
        </quote>
      </cit>
