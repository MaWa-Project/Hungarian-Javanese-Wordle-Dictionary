      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">lát</orth>
          <orth script="Runic">𐳖𐳁𐳦</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">szemlél</orth>
          <orth script="Runic">𐳥𐳉𐳘𐳖𐳋𐳖</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	látni, érzékelni a szemmel
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳖𐳁𐳦𐳙𐳐, 𐳋𐳢𐳯𐳋𐳓𐳉𐳖𐳙𐳐 𐳀 𐳥𐳉𐳘𐳘𐳉𐳖
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Aku weruh kucing ing ndhuwur pager</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦏꦸꦮꦼꦫꦸꦃꦏꦸꦕꦶꦁꦲꦶꦁꦔ꧀ꦝꦸꦮꦸꦂꦥꦒꦼꦂ
        </quote>
        <quote xml:lang="Hu" script="Latin">Látok egy macskát a kerítésen</quote>
        <quote xml:lang="Hu" script="Runic">
          𐳖𐳁𐳦𐳛𐳓 𐳉𐳎 𐳘𐳀𐳆𐳓𐳁𐳦 𐳀 𐳓𐳉𐳢𐳐𐳦𐳋𐳤𐳉𐳙
        </quote>
      </cit>
