        </pron>
        <gramGrp>
          <pos>substantive</pos>
          <inflection type="plural">
            <orth xml:lang="Jv" script="Latin">-selop</orth>
            <orth xml:lang="Jv" script="Jv">-ꦱꦼꦭꦺꦴꦥ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">papucs</orth>
          <orth script="Runic">𐳠𐳀𐳠𐳪𐳖𐳤</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">szandál</orth>
          <orth script="Runic">𐳥𐳀𐳙𐳇𐳁𐳖</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	házi papucs, lábbeli
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳏𐳁𐳯𐳐 𐳠𐳀𐳠𐳪𐳖𐳤, 𐳖𐳁𐳁𐳀𐳖𐳐
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Selope anyar ditukokake ibu wingi</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦱꦼꦭꦺꦴꦥꦺꦲꦚꦂꦢꦶꦠꦸꦏꦺꦴꦏ꧀ꦏꦏꦺꦲꦶꦧꦸꦮꦶꦔꦶ
        </quote>
        <quote xml:lang="Hu" script="Latin">Az új papucsot anya vette tegnap</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀𐳯 𐳫𐳒 𐳠𐳀𐳠𐳪𐳖𐳤𐳛𐳦 𐳀𐳙𐳀 𐳮𐳉𐳦𐳦𐳉 𐳦𐳉𐳍𐳋𐳀𐳠
        </quote>
      </cit>
