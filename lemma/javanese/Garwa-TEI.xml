<entry xml:id="garwa">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">garwa</orth>
        <orth xml:lang="Jv" script="Jv">ꦒꦂꦮ</orth>
        <pron>
          <syllabic>gar·wa</syllabic>
          <ipa>[\text{ɡarwɔ}]</ipa>
        </pron>
        <gramGrp>
          <pos>substantive</pos>
          <inflection type="plural">
            <orth xml:lang="Jv" script="Latin">-garwa</orth>
            <orth xml:lang="Jv" script="Jv">-ꦒꦂꦮ</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">házastárs</orth>
          <orth script="Runic">𐳏𐳁𐳯𐳀𐳤𐳦𐳁𐳢𐳤</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">hitves</orth>
          <orth script="Runic">𐳏𐳐𐳦𐳮𐳉𐳤</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	házasságban élõ személy
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳏𐳁𐳯𐳀𐳤𐳀𐳍𐳁𐳀𐳙 𐳉𐳖𐳟 𐳥𐳉𐳘𐳋𐳗
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Garwaku kuwi wong sing sabar banget</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦒꦂꦮꦏꦸꦏꦸꦮꦶꦮꦺꦴꦁꦱꦶꦁꦱꦧꦂꦧꦔꦼꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A házastársam nagyon kedves ember</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳏𐳁𐳯𐳀𐳤𐳦𐳁𐳢𐳤𐳀𐳘 𐳙𐳀𐳎𐳛𐳙 𐳓𐳉𐳇𐳮𐳉𐳤 𐳉𐳘𐳁𐳉𐳢
        </quote>
      </cit>
