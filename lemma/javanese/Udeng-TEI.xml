<?xml version="1.0" encoding="UTF-8"?>
<entry xml:id="udeng">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">udeng</orth>
        <orth xml:lang="Jv" script="Jv">ꦲꦸꦢꦼꦁ</orth>
        <pron>
          <syllabic>u·deng</syllabic>
          <ipa>[\text{ud̪əŋ}]</ipa>
        </pron>
        <gramGrp>
          <pos>substantive</pos>
          <inflection type="plural">
            <orth xml:lang="Jv" script="Latin">-udeng</orth>
            <orth xml:lang="Jv" script="Jv">-ꦲꦸꦢꦼꦁ</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">fejkendő</orth>
          <orth script="Runic">𐳌𐳉𐳒𐳓𐳉𐳙𐳇𐳟</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">pánt</orth>
          <orth script="Runic">𐳠𐳁𐳙𐳦</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	fejre kötött hagyományos kendő
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳌𐳉𐳒𐳢𐳉 𐳓𐳟𐳦𐳟𐳦𐳦 𐳏𐳀𐳎𐳛𐳘𐳀𐳚𐳛𐳤 𐳓𐳉𐳙𐳇𐳟
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Udeng iki dienggo nalika mantenan adat</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦸꦢꦼꦁꦲꦶꦏꦶꦢꦶꦲꦼꦁꦒꦺꦴꦤꦭꦶꦏꦩꦤ꧀ꦠꦺꦤ꧀ꦤꦤ꧀ꦲꦢꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A fejkendőt az ünnepi ruhán viselik</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳌𐳉𐳒𐳓𐳉𐳙𐳇𐳟𐳦 𐳀𐳯 𐳬𐳙𐳙𐳉𐳠𐳐 𐳢𐳪𐳏𐳁𐳙 𐳮𐳐𐳤𐳉𐳖𐳐𐳓
        </quote>
      </cit>
