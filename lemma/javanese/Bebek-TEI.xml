          <orth script="Latin">réce</orth>
          <orth script="Runic">𐳢𐳋𐳖𐳉</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	vízi szárnyas, háziállat
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳮𐳑𐳯𐳐 𐳥𐳁𐳢𐳚𐳀𐳤, 𐳏𐳁𐳯𐳐𐳁𐳖𐳖𐳀𐳦
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Bebek iku seneng nglangi ing kali</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦧꦼꦧꦼꦏ꧀ꦲꦶꦏꦸꦱꦼꦤꦼꦁꦔ꧀ꦭꦔꦶꦲꦶꦁꦏꦭꦶ
        </quote>
        <quote xml:lang="Hu" script="Latin">A kacsa szeret a folyóban úszni</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳓𐳀𐳆𐳀 𐳥𐳉𐳢𐳉𐳦 𐳀 𐳌𐳛𐳖𐳚𐳜𐳁𐳀𐳙 𐳫𐳤𐳙𐳐
        </quote>
      </cit>
