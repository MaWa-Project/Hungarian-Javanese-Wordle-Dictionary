          <inflection type="plural">
            <orth xml:lang="Jv" script="Latin">-bebek</orth>
            <orth xml:lang="Jv" script="Jv">-ꦧꦼꦧꦼꦏ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
