      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">kókuszpalacsinta</orth>
          <orth script="Runic">𐳓𐳜𐳓𐳪𐳤𐳠𐳀𐳖𐳀𐳆𐳐𐳙𐳦𐳀</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	kókusztejjel készült palacsinta
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳓𐳜𐳓𐳪𐳤𐳦𐳉𑁦𐳖𐳀𐳦 𐳓𐳉𐳥𐳬𐳖𐳦 𐳠𐳀𐳖𐳀𐳆𐳐𐳙𐳦𐳀
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Srabi iku enak dipangan karo kuah santen</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦱꦿꦧꦶꦲꦶꦏꦸꦲꦺꦤꦏ꧀ꦢꦶꦥꦔꦤ꧀ꦏꦫꦺꦴꦏꦸꦮꦃꦱꦤ꧀ꦠꦼꦤ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A srapit szósszal eszik a legjobb</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳤𐳢𐳀𐳠𐳐𐳦 𐳥𐳜𐳤𐳤𐳀𐳖 𐳉𐳤𐳐𐳓 𐳀 𐳖𐳉𐳍𐳒𐳛𐳁𐳁
        </quote>
      </cit>
