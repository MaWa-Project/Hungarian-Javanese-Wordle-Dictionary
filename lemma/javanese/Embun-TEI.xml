      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">harmatcsepp</orth>
          <orth script="Runic">𐳏𐳀𐳢𐳘𐳀𐳦𐳖𐳉𐳠𐳠</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	reggeli vízcsepp a növényeken
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳢𐳉𐳍𐳉𐳖𐳐 𐳮𐳑𐳯𐳖𐳉𐳠𐳠 𐳀 𐳙𐳟𐳮𐳋𐳚𐳉𐳓𐳉𐳙
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Embun esuk iku adhem lan resik</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦼꦩ꧀ꦧꦸꦤ꧀ꦲꦺꦱꦸꦏ꧀ꦲꦶꦏꦸꦲꦢꦼꦩ꧀ꦭꦤ꧀ꦉꦱꦶꦏ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A reggeli harmat hideg és tiszta</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳢𐳉𐳍𐳉𐳖𐳐 𐳏𐳀𐳢𐳘𐳀𐳦 𐳏𐳐𐳇𐳉𐳍 𐳋𐳤 𐳦𐳐𐳤𐳦𐳀
        </quote>
      </cit>
