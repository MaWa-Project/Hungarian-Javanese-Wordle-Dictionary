<entry xml:id="pitik">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">pitik</orth>
        <orth xml:lang="Jv" script="Jv">ꦥꦶꦠꦶꦏ꧀</orth>
        <pron>
          <syllabic>pi·tik</syllabic>
          <ipa>[\text{pitiʔ}]</ipa>
        </pron>
        <gramGrp>
          <pos>substantive</pos>
          <inflection type="plural">
            <orth xml:lang="Jv" script="Latin">-pitik</orth>
            <orth xml:lang="Jv" script="Jv">-ꦥꦶꦠꦶꦏ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">csirke</orth>
          <orth script="Runic">𐳆𐳐𐳢𐳓𐳉</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">tyúk</orth>
          <orth script="Runic">𐳦𐳚𐳋𐳓</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	baromfi, háziszárnyas húsért és tojásért
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳁𐳀𐳢𐳛𐳘𐳌𐳐, 𐳏𐳁𐳯𐳐𐳥𐳁𐳢𐳚𐳀𐳤 𐳏𐳭𐳤𐳋𐳢𐳦 𐳋𐳤 𐳦𐳛𐳒𐳁𐳤𐳋𐳢𐳦
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Pitik iku kewan sing saben dina dipangan</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦥꦶꦠꦶꦏ꧀ꦲꦶꦏꦸꦏꦺꦮꦤ꧀ꦱꦶꦁꦱꦧꦼꦤ꧀ꦢꦶꦤꦢꦶꦥꦔꦤ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A csirkét minden nap megeszik</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳆𐳐𐳢𐳓𐳋𐳦 𐳘𐳐𐳙𐳇𐳉𐳙 𐳙𐳀𐳠 𐳘𐳉𐳍𐳉𐳤𐳐𐳓
        </quote>
      </cit>
