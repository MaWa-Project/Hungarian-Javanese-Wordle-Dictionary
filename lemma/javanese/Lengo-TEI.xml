<?xml version="1.0" encoding="UTF-8"?>
<entry xml:id="lengo">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">lengo</orth>
        <orth xml:lang="Jv" script="Jv">ꦭꦼꦔꦺꦴ</orth>
        <pron>
          <syllabic><break>[lengo]</break></syllabic>
          <ipa>[\text{lɛŋɔ}]</ipa>
        </pron>
        <gramGrp>
          <pos>substantive</pos>
          <inflection type="plural">
            <orth xml:lang="Jv" script="Latin">-lengo</orth>
            <orth xml:lang="Jv" script="Jv">-ꦭꦼꦔꦺꦴ</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">olaj</orth>
          <orth script="Runic">𐳛𐳖𐳀𐳒</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">étolaj</orth>
          <orth script="Runic">𐳋𐳦𐳛𐳖𐳀𐳒</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	növényi olaj, sütéshez való
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳙𐳟𐳮𐳋𐳚𐳐 𐳛𐳖𐳀𐳒, 𐳤𐳬𐳦𐳋𐳤𐳏𐳉𐳯 𐳮𐳀𐳖𐳜
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Lengo klentik iku apik kanggo masak</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦭꦼꦔꦺꦴꦏ꧀ꦊꦤ꧀ꦠꦶꦏ꧀ꦲꦶꦏꦸꦲꦥꦶꦏ꧀ꦏꦁꦒꦺꦴꦩꦱꦏ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A kókuszolaj jó a sütéshez</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳓𐳜𐳓𐳪𐳥𐳛𐳖𐳀𐳒 𐳒𐳜 𐳀 𐳤𐳬𐳦𐳋𐳤𐳏𐳉𐳯
        </quote>
      </cit>
      <note type="synonyms">
        <list>
          <item>
            <orth script="Latin">lisah</orth>
            <orth script="Jv">ꦭꦶꦱꦃ</orth>
