<?xml version="1.0" encoding="UTF-8"?>
<entry xml:id="manuk">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">manuk</orth>
        <orth xml:lang="Jv" script="Jv">ꦩꦤꦸꦏ꧀</orth>
        <pron>
          <syllabic>ma·nuk</syllabic>
          <ipa>[\text{manuk}]</ipa>
        </pron>
        <gramGrp>
          <pos>substantive</pos>
          <inflection type="plural">
            <orth xml:lang="Jv" script="Latin">-manuk</orth>
            <orth xml:lang="Jv" script="Jv">-ꦩꦤꦸꦏ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">madár</orth>
          <orth script="Runic">𐳘𐳀𐳇𐳁𐳢</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">szárnyas</orth>
          <orth script="Runic">𐳥𐳁𐳢𐳚𐳀𐳤</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	állat, amelynek szárnya és tolla van, és tud repülni
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳁𐳖𐳖𐳀𐳦⹁ 𐳀𐳘𐳉𐳗𐳙𐳉𐳓 𐳥𐳁𐳢𐳚𐳀 𐳋𐳤 𐳦𐳛𐳖𐳖𐳀 𐳮𐳀𐳙⹁ 𐳋𐳤 𐳦𐳪𐳇 𐳢𐳉𐳠𐳬𐳖𐳙𐳐
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">manuk‑manuké padha mabur</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦩꦤꦸꦏ꧀ꦩꦤꦸꦏꦺꦥꦣꦩꦧꦸꦂ
        </quote>
        <quote xml:lang="Hu" script="Latin">A madarak repülnek</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳘𐳀𐳇𐳀𐳢𐳀𐳓 𐳢𐳉𐳠𐳬𐳖𐳙𐳉𐳓
        </quote>
      </cit>
