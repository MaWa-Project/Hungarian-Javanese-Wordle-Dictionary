<entry xml:id="ketok">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">ketok</orth>
        <orth xml:lang="Jv" script="Jv">ꦏꦼꦠꦺꦴꦏ꧀</orth>
        <pron>
          <syllabic>ke·tok</syllabic>
          <ipa>[\text{kətɔʔ}]</ipa>
        </pron>
        <gramGrp>
          <pos>verb</pos>
          <inflection type="reduplication">
            <orth xml:lang="Jv" script="Latin">ketok-ketok</orth>
            <orth xml:lang="Jv" script="Jv">ꦏꦼꦠꦺꦴꦏ꧀ꦏꦼꦠꦺꦴꦏ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">látszik</orth>
          <orth script="Runic">𐳖𐳁𐳆𐳐𐳓</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">mutatkozik</orth>
          <orth script="Runic">𐳘𐳪𐳦𐳀𐳦𐳓𐳛𐳯𐳐𐳓</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	láthatóvá válik, megmutatkozik
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳖𐳁𐳦𐳏𐳀𐳦𐳜𐳮𐳁 𐳮𐳁𐳖𐳐𐳓, 𐳘𐳉𐳍𐳘𐳪𐳦𐳀𐳦𐳓𐳛𐳯𐳐𐳓
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Ketok saka adoh omah gedhe banget</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦏꦼꦠꦺꦴꦏ꧀ꦱꦏꦲꦢꦺꦴꦃꦲꦺꦴꦩꦃꦒꦼꦝꦺꦧꦔꦼꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">Messziről látszik a nagy ház</quote>
        <quote xml:lang="Hu" script="Runic">
          𐳘𐳉𐳤𐳤𐳯𐳐𐳢𐳟𐳖 𐳖𐳁𐳆𐳐𐳓 𐳀 𐳙𐳀𐳎 𐳏𐳁𐳯
        </quote>
      </cit>
