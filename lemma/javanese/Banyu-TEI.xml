      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">folyadék</orth>
          <orth script="Runic">𐳌𐳛𐳖𐳀𐳇𐳋𐳓</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	átlátszó folyadék, élethez szükséges
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳁𐳦𐳖𐳁𐳆𐳜 𐳌𐳛𐳖𐳀𐳇𐳋𐳓, 𐳋𐳖𐳉𐳦𐳏𐳉𐳯 𐳥𐳬𐳓𐳤𐳋𐳍𐳉𐳤
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Aku ngombe banyu adhem sawise olahraga</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦏꦸꦔꦺꦴꦩ꧀ꦧꦺꦧꦚꦸꦲꦢꦼꦩ꧀ꦱꦮꦶꦱꦺꦲꦺꦴꦭꦃꦫꦒ
        </quote>
        <quote xml:lang="Hu" script="Latin">Vizet ittam az edzés után</quote>
        <quote xml:lang="Hu" script="Runic">
          𐳮𐳐𐳯𐳉𐳦 𐳐𐳦𐳦𐳀𐳘 𐳀𐳯 𐳉𐳇𐳯𐳋𐳤 𐳪𐳦𐳁𐳙
        </quote>
      </cit>
