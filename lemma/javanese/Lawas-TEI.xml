<?xml version="1.0" encoding="UTF-8"?>
<entry xml:id="lawas">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">lawas</orth>
        <orth xml:lang="Jv" script="Jv">ꦭꦮꦱ꧀</orth>
        <pron>
          <syllabic>la·was</syllabic>
          <ipa>[\text{lawas}]</ipa>
        </pron>
        <gramGrp>
          <pos>adjective</pos>
          <inflection type="reduplication">
            <orth xml:lang="Jv" script="Latin">lawas-lawas</orth>
            <orth xml:lang="Jv" script="Jv">ꦭꦮꦱ꧀ꦭꦮꦱ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">régi</orth>
          <orth script="Runic">𐳢𐳋𐳍𐳐</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">ősrégi</orth>
          <orth script="Runic">𐳟𐳤𐳢𐳋𐳍𐳐</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	már hosszú ideje meglevő, nem új
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳘𐳁𐳢 𐳏𐳛𐳤𐳥𐳫 𐳐𐳇𐳉𐳒𐳉 𐳘𐳉𐳍𐳖𐳉𐳮𐳟, 𐳙𐳉𐳘 𐳫𐳒
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Omah lawas iki isih kuwat banget</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦺꦴꦩꦃꦭꦮꦱ꧀ꦲꦶꦏꦶꦲꦶꦱꦶꦃꦏꦸꦮꦠ꧀ꦧꦔꦼꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">Ez a régi ház erős maradt</quote>
        <quote xml:lang="Hu" script="Runic">
          𐳉𐳯 𐳀 𐳢𐳋𐳍𐳐 𐳏𐳁𐳯 𐳉𐳢𐳟𐳤 𐳘𐳀𐳢𐳀𐳇𐳦
        </quote>
      </cit>
      <note type="synonyms">
        <list>
