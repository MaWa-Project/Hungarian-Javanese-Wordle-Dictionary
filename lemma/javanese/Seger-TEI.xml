      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	erőt adó, frissítő érzés
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳉𐳢𐳟𐳦 𐳀𐳇𐳜, 𐳌𐳢𐳐𐳤𐳤𐳐𐳦𐳟 𐳋𐳢𐳯𐳋𐳤
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Seger rasane sawise adus banyu anget</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦱꦼꦒꦼꦂꦫꦱꦤꦺꦱꦮꦶꦱꦺꦲꦢꦸꦱ꧀ꦧꦚꦸꦲꦔꦼꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">Friss érzés a meleg víz után</quote>
        <quote xml:lang="Hu" script="Runic">
          𐳌𐳢𐳐𐳤𐳤 𐳋𐳢𐳯𐳋𐳤 𐳀 𐳘𐳉𐳖𐳉𐳍 𐳮𐳑𐳯 𐳪𐳦𐳁𐳙
        </quote>
      </cit>
