<?xml version="1.0" encoding="UTF-8"?>
<entry xml:id="anget">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">anget</orth>
        <orth xml:lang="Jv" script="Jv">ꦲꦔꦼꦠ꧀</orth>
        <pron>
          <syllabic>a·nget</syllabic>
          <ipa>[\text{aŋət}]</ipa>
        </pron>
        <gramGrp>
          <pos>adjective</pos>
          <inflection type="reduplication">
            <orth xml:lang="Jv" script="Latin">anget-anget</orth>
            <orth xml:lang="Jv" script="Jv">ꦲꦔꦼꦠ꧀ꦲꦔꦼꦠ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">meleg</orth>
          <orth script="Runic">𐳘𐳉𐳖𐳉𐳍</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">langyos</orth>
          <orth script="Runic">𐳖𐳀𐳙𐳎𐳛𐳤</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	kellemesen meleg, nem hideg
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳓𐳉𐳖𐳖𐳉𐳘𐳉𐳤𐳉𐳙 𐳘𐳉𐳖𐳉𐳍, 𐳙𐳉𐳘 𐳏𐳐𐳇𐳉𐳍
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Anget srengenge esuk iku nyenengake</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦲꦔꦼꦠ꧀ꦱꦽꦔꦼꦔꦺꦲꦺꦱꦸꦏ꧀ꦲꦶꦏꦸꦚꦼꦤꦼꦁꦔꦏꦺ
        </quote>
        <quote xml:lang="Hu" script="Latin">A reggeli nap melege nagyon kellemes</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳢𐳉𐳍𐳉𐳖𐳐 𐳙𐳀𐳠 𐳘𐳉𐳖𐳉𐳍𐳉 𐳙𐳀𐳎𐳛𐳙 𐳓𐳉𐳖𐳖𐳉𐳘𐳉𐳤
        </quote>
      </cit>
      <note type="synonyms">
        <list>
          <item>
            <orth script="Latin">bentêr</orth>
		    <orth script="Jv">ꦧꦼꦤ꧀ꦠꦼꦂ</orth>
          </item>
        </list>
      </note>
      <note type="compounds">
        <list>
          <item>
            <orth script="Latin">-an</orth>
            <orth script="Jv">-ꦲꦤ꧀</orth>
          </item>
        </list>
      </note>
      <note type="crossReference">
        <ref target="#bentêr">
          <orth script="Latin">bentêr</orth>
