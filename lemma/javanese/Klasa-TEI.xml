      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">szőnyeg</orth>
          <orth script="Runic">𐳥𐳟𐳚𐳉𐳍</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	padlóra tett növényi szőnyeg
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳠𐳀𐳇𐳖𐳜𐳢𐳀 𐳦𐳉𐳦𐳦 𐳙𐳝𐳮𐳋𐳚𐳐 𐳥𐳟𐳚𐳉𐳍
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Klasa anyar iki krasa adem banget</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦏ꧀ꦭꦱꦲꦚꦂꦲꦶꦏꦶꦏꦿꦱꦲꦢꦼꦩ꧀ꦧꦔꦼꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">Az új gyékényen ülök a szobában</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀𐳯 𐳫𐳒 𐳎𐳋𐳓𐳋𐳚𐳉𐳙 𐳬𐳖𐳝𐳓 𐳀 𐳥𐳛𐳁𐳀𐳁𐳀𐳙
        </quote>
      </cit>
