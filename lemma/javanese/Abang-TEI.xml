<?xml version="1.0" encoding="UTF-8"?>
<entry xml:id="abang">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">abang</orth>
        <orth xml:lang="Jv" script="Jv">ꦲꦧꦁ</orth>
        <pron>
          <syllabic>a·bang</syllabic>
          <ipa>[\text{abaŋ}]</ipa>
        </pron>
        <gramGrp>
          <pos>adjective</pos>
          <inflection type="reduplication">
            <orth xml:lang="Jv" script="Latin">abang-abang</orth>
            <orth xml:lang="Jv" script="Jv">ꦲꦧꦁꦲꦧꦁ</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">piros</orth>
          <orth script="Runic">𐳠𐳐𐳢𐳛𐳤</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">vörös</orth>
          <orth script="Runic">𐳮𐳟𐳢𐳟𐳤</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	vér színű szín, az egyik alapszín
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳮𐳋𐳢 𐳥𐳐𐳚𐳭 𐳥𐳐𐳙, 𐳀𐳯 𐳉𐳎𐳐𐳓 𐳀𐳖𐳀𐳠𐳥𐳐𐳙
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Kembang mawar abang iku ayu banget</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦏꦼꦩ꧀ꦧꦁꦩꦮꦂꦲꦧꦁꦲꦶꦏꦸꦲꦪꦸꦧꦔꦼꦠ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A piros virág nagyon szép</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳠𐳐𐳢𐳛𐳤 𐳮𐳐𐳢𐳁𐳍 𐳙𐳀𐳎𐳛𐳙 𐳥𐳋𐳠
        </quote>
      </cit>
