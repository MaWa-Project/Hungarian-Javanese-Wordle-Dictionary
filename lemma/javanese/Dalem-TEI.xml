<?xml version="1.0" encoding="UTF-8"?>
<entry xml:id="dalem">
	<form type="lemma">
    	<orth xml:lang="Jv" script="Latin">dalem</orth>
        <orth xml:lang="Jv" script="Jv">ꦢꦊꦩ꧀</orth>
        <pron>
          <syllabic>da·lem</syllabic>
          <ipa>[\text{daləm}]</ipa>
        </pron>
        <gramGrp>
          <pos>substantive</pos>
          <inflection type="plural">
            <orth xml:lang="Jv" script="Latin">-dalem</orth>
            <orth xml:lang="Jv" script="Jv">-ꦢꦊꦩ꧀</orth>
          </inflection>
        </gramGrp>
      </form>
      <sense xml:id="közb">
        <usg type="register" xml:lang="Hu">közb.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">ház</orth>
          <orth script="Runic">𐳏𐳁𐳯</orth>
        </cit>
      </sense>
      <sense xml:id="irod">
        <usg type="register" xml:lang="Hu">irod.</usg>
        <cit type="translation" xml:lang="Hu">
          <orth script="Latin">lakás</orth>
          <orth script="Runic">𐳖𐳀𐳓𐳁𐳤</orth>
        </cit>
      </sense>
      <def>
        <p>
          <seg xml:lang="Hu" script="Latin">
          	lakóépület, ház (krama)
          </seg>
          <seg xml:lang="Hu" script="Runic">
          	𐳖𐳀𐳓𐳜𐳠𐳬𐳖𐳉𐳦, 𐳏𐳁𐳯 (𐳓𐳢𐳀𐳘𐳀)
          </seg>
        </p>
      </def>
      <cit type="example">
        <quote xml:lang="Jv" script="Latin">Daleme ageng sanget lan resik</quote>
        <quote xml:lang="Jv" script="Jv">
          ꦢꦊꦩꦺꦲꦒꦼꦁꦱꦔꦼꦠ꧀ꦭꦤ꧀ꦉꦱꦶꦏ꧀
        </quote>
        <quote xml:lang="Hu" script="Latin">A ház nagyon nagy és tiszta</quote>
        <quote xml:lang="Hu" script="Runic">
          𐲀 𐳏𐳁𐳯 𐳙𐳀𐳎𐳛𐳙 𐳙𐳀𐳎 𐳋𐳤 𐳦𐳐𐳤𐳦𐳀
        </quote>
      </cit>
